{
  "name": "buzer-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/db && cp src/db/schema.sql dist/db/schema.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --import ./dist/instrument.js ./dist/server.js",
    "dev": "node --import tsx --import ./src/instrument.ts ./src/server.ts",
    "e2e-server": "tsx test/e2eServer.ts",
    "migrate": "tsx src/db/migrations.ts",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org \"${SENTRY_ORG:-jans-gi}\" --project \"${SENTRY_PROJECT:-buzer-backend}\" ./dist && sentry-cli sourcemaps upload --org \"${SENTRY_ORG:-jans-gi}\" --project \"${SENTRY_PROJECT:-buzer-backend}\" --release \"${SENTRY_RELEASE:-app.buzer@0.1.0+local}\" ./dist"
  },
  "dependencies": {
    "@fastify/rate-limit": "10.3.0",
    "@fastify/sensible": "6.0.4",
    "@sentry/node": "10.72.0",
    "better-sqlite3": "12.10.0",
    "dotenv": "17.4.2",
    "fastify": "5.8.5",
    "qrcode-terminal": "0.12.0",
    "whatsapp-web.js": "1.34.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@sentry/cli": "3.6.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.20",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": "22.x"
  }
}
