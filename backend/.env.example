NODE_ENV=development
PORT=3001
DATABASE_PATH=./data/buzer-dev.db
ANDROID_API_TOKEN=replace-with-local-dev-token
TODOIST_API_TOKEN=replace-with-todoist-token
TODOIST_USER_ID=replace-with-current-user-id
WHATSAPP_RECIPIENT_ID=replace-with-chat-id
WHATSAPP_DRY_RUN=true
WHATSAPP_SESSION_PATH=./whatsapp-sessions
WHATSAPP_CLIENT_ID=buzer
# Sentry Observability & Release Management
SENTRY_BACKEND_DSN=
SENTRY_ENVIRONMENT=development-vps
SENTRY_RELEASE=app.buzer@0.1.0+local
# Sentry Org & Project for CLI / Release management
SENTRY_ORG=jans-gi
SENTRY_PROJECT=buzer-backend
# SENTRY_AUTH_TOKEN is used for source-map/mapping uploads during build/deploy (do not commit)
SENTRY_AUTH_TOKEN=
