# Backend Runtime Environment

# Todoist
TODOIST_API_TOKEN=replace-with-todoist-personal-access-token
TODOIST_USER_ID=replace-with-your-todoist-user-id

# Android API
ANDROID_API_TOKEN=replace-with-random-secure-token

# WhatsApp Escalation
WHATSAPP_RECIPIENT_ID=replace-with-chat-id
WHATSAPP_DRY_RUN=false
WHATSAPP_SESSION_PATH=./whatsapp-sessions
WHATSAPP_CLIENT_ID=buzer

# Backend
PORT=3000
DATABASE_PATH=./data/buzer.sqlite

# Sentry Observability
SENTRY_BACKEND_DSN=
SENTRY_ENVIRONMENT=development-vps
SENTRY_RELEASE=buzer-backend@0.1.0+local

