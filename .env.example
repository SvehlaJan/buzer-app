# Backend Runtime Environment

# Todoist
TODOIST_API_TOKEN=replace-with-todoist-personal-access-token
TODOIST_USER_ID=replace-with-your-todoist-user-id

# Android API
ANDROID_API_TOKEN=replace-with-random-secure-token

# WhatsApp Escalation
WHATSAPP_RECIPIENT_ID=replace-with-chat-id
WHATSAPP_DRY_RUN=false
WHATSAPP_SESSION_PATH=./whatsapp-sessions
WHATSAPP_CLIENT_ID=buzer

# Backend
PORT=3000
DATABASE_PATH=./data/buzer.sqlite

# Sentry Observability & Release Management
SENTRY_BACKEND_DSN=
SENTRY_ENVIRONMENT=development-vps
# Leave SENTRY_RELEASE unset: deploy/build derives it from the checked-out Git SHA.
# Set it only when deliberately overriding that derived release.
# Sentry Org & Project for CLI / Release management
SENTRY_ORG=jans-gi
SENTRY_PROJECT=buzer-backend
# SENTRY_AUTH_TOKEN is used for source-map/mapping uploads during build/deploy (do not commit)
SENTRY_AUTH_TOKEN=
